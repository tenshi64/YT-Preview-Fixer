{
    "manifest_version": 3,
    "name": "YouTube Preview Fixer",
    "description": "WORK IN PROGRESS",
    "version": "1.0.0",
    "icons": {
        "16": "/images/icon.png",
        "48": "/images/icon.png",
        "128": "/images/icon.png"
    },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["/scripts/extension.js"],
        "run_at": "document_end"
    }]
}