{
    "manifest_version": 3,
    "name": "YouTube Preview Fixer",
    "description": "Made by tenshi",
    "version": "1.0.1",
    "icons": {
        "16": "/images/icon.png",
        "48": "/images/icon.png",
        "128": "/images/icon.png"
    },
    "content_scripts": [{
        "matches": ["https://www.youtube.com/"],
        "js": ["/scripts/extension.js"],
        "run_at": "document_end"
    }]
}
